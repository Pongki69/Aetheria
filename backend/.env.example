# Copy to .env and configure before enabling account registration/password reset.
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Provider keys stay on the backend and are never sent to the browser.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Raw Sketchfab API token value (server-side only; do not include the "Token " prefix).
SKETCHFAB_API_TOKEN=

# Start LM Studio's local server in the Developer tab before using local models.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# Optional: set this only if LM Studio API authentication is enabled.
LM_STUDIO_API_KEY=

RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Aetheria <accounts@your-verified-domain.example>
# Use a unique random value of 32+ characters; never commit the real value.
OTP_PEPPER=replace-with-a-long-random-secret

# Set these once to bootstrap the first administrator account. Password must be 10+ characters.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Aetheria Admin

# Required to accept Google OAuth ID tokens from the browser.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

